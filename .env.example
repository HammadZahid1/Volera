# ─────────────────────────────────────────────────────────────
# VELORA — environment configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL database (required — used locally AND on Vercel).
# Supabase: Project Settings → Database → "Session pooler" connection string.
# Example:
# VELORA_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
VELORA_DATABASE_URL="postgresql://user:password@host:5432/velora"

# 32+ character random string used to sign server-side sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Public site URL (used for metadata and absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed credentials (development only) ─────────────────────
# These are used by `npm run db:seed` to create demo accounts.
SEED_ADMIN_EMAIL="admin@velora.com"
SEED_ADMIN_PASSWORD="VeloraAdmin!2026"
SEED_CUSTOMER_EMAIL="customer@velora.com"
SEED_CUSTOMER_PASSWORD="VeloraDemo!2026"
