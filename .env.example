# ──────────────────────────────────────────────────────────────
# VELORA — environment configuration
# Copy this file to `.env` and fill in the values.
# ──────────────────────────────────────────────────────────────

# Database (local development uses SQLite)
VELORA_DATABASE_URL="file:./dev.db"

# 32+ character random string used to sign server-side sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Public site URL (used for metadata and absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed credentials (development only) ──────────────────────
# These are used by `npm run db:seed` to create demo accounts.
SEED_ADMIN_EMAIL="admin@velora.com"
SEED_ADMIN_PASSWORD="VeloraAdmin!2026"
SEED_CUSTOMER_EMAIL="customer@velora.com"
SEED_CUSTOMER_PASSWORD="VeloraDemo!2026"

# ── Production database (Supabase / PostgreSQL) ──────────────
# VELORA ships with a Prisma schema that targets SQLite for a
# zero-config local experience. For production, switch the
# Prisma provider to "postgresql" and set DATABASE_URL to your
# Supabase connection string (see README → Deployment).
# Never expose the service-role key to the browser.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY="<public-anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<server-only-service-role-key>"
