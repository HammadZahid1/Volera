# ─────────────────────────────────────────────────────────────
# VELORA — environment configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────
# NOTE: VELORA runs with zero environment variables — SQLite is used for
# local development and deployments bundle a pristine demo database.
# Everything below is optional.

# Database (local development uses SQLite; created by `npm run db:reset`)
VELORA_DATABASE_URL="file:./dev.db"

# 32+ character random string used to sign server-side sessions.
# If unset, an ephemeral per-process secret is used (fine for demos;
# sessions reset when the server restarts). For real deployments, set it:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Public site URL (used for metadata and absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed credentials (development only) ─────────────────────
# Used by `npm run db:seed` — defaults are built in, override as needed.
SEED_ADMIN_EMAIL="admin@velora.com"
SEED_ADMIN_PASSWORD="VeloraAdmin!2026"
SEED_CUSTOMER_EMAIL="customer@velora.com"
SEED_CUSTOMER_PASSWORD="VeloraDemo!2026"

# ── Real database (optional) ────────────────────────────────
# To run against PostgreSQL instead (Supabase, Neon, …):
# 1. Change provider to "postgresql" in prisma/schema.prisma
# 2. Delete prisma/demo.db
# 3. Point VELORA_DATABASE_URL at your connection string, e.g.
# VELORA_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
